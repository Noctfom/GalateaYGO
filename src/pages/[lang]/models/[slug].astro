---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import Artwork from '../../../components/Artwork.astro';
import Discussion from '../../../components/Discussion.astro';
import {models,text as t,path,formatBytes,type Lang,type Model} from '../../../lib/catalog';
export function getStaticPaths(){return ['zh','en'].flatMap(lang=>models.map(model=>({params:{lang,slug:model.slug},props:{model}})));}
const lang=Astro.params.lang as Lang;const {model}=Astro.props as {model:Model};
const attachmentNames:Record<string,{zh:string,en:string}>={decks:{zh:'卡组',en:'Decks'},replays:{zh:'回放',en:'Replays'},documents:{zh:'使用说明',en:'Documentation'},presets:{zh:'预设文件',en:'Presets'}};
---
<Layout lang={lang} title={model.name} active="models"><div class="container page-content">
  <div class="breadcrumbs"><a href={path(lang,'models')}>{t(lang,'模型广场','Models')}</a><Icon name="chevron" size={12}/><span>{model.name}</span></div>
  <div class="model-title-row"><div class={`model-avatar accent-${model.accent}`}><Artwork variant={model.accent}/></div><div><div class="detail-author">{model.author.github?<a href={model.author.github} target="_blank" rel="noopener noreferrer">{model.author.name}<Icon name="external" size={11}/></a>:model.author.name}{model.example&&<span class="badge">{t(lang,'示例模型','Example model')}</span>}</div><h1>{model.name}</h1><p>{model.summary[lang]}</p></div><button class="button button-outline favorite detail-save" data-favorite={model.id} aria-pressed="false" aria-label={t(lang,'收藏这个模型','Save this model')}><Icon name="star" size={17}/>{t(lang,'收藏','Save')}</button></div>
  {model.example&&<div class="notice">{t(lang,'这是页面体验用的示例，不对应已发布的模型。你可以浏览说明和切换版本；示例不提供模型下载','This is a preview example, not a published model. Explore its description and switch releases; no model download is provided.')}</div>}
  <div class="detail-layout"><div><div class="detail-tabs" role="tablist" aria-label={t(lang,'模型信息','Model information')}><button role="tab" id="tab-about" aria-selected="true" aria-controls="panel-about" data-tab="about">{t(lang,'模型介绍','Model card')}</button><button role="tab" id="tab-releases" aria-selected="false" aria-controls="panel-releases" data-tab="releases" tabindex="-1">{t(lang,'版本记录','Releases')}<span>{model.releases.length}</span></button></div>
    <section id="panel-about" role="tabpanel" aria-labelledby="tab-about" class="prose detail-prose"><h2>{t(lang,'关于这个模型','About this model')}</h2>{model.description[lang].split('\n\n').map(paragraph=><p>{paragraph}</p>)}<h2>{t(lang,'使用前了解','Before you start')}</h2><div class="detail-note"><Icon name="layers" size={21}/><div><strong>{t(lang,'部署包与模型协议是两个版本','Package and model versions are separate')}</strong><p>{t(lang,'GKG4 / GKG5 描述包的内容组织方式；V4 描述模型使用的协议。具体兼容性由 Core 或 Link 导入时检查','GKG4 / GKG5 describes the package container; V4 describes the model protocol. Core or Link checks compatibility when importing.')}</p></div></div><h2>{t(lang,'评测记录','Evaluation')}</h2><p>{t(lang,'暂无随此条目提供的评测报告。训练轮数不能直接代表对局强度，请结合作者的固定条件评测选择模型','No evaluation report accompanies this listing. Training iterations alone do not establish playing strength; compare models using documented evaluation conditions.')}</p><a class="text-link" href={path(lang,'docs/choose-model')}>{t(lang,'怎样选择适合的模型','How to choose a model')}<Icon name="arrow" size={15}/></a></section>
    <section id="panel-releases" role="tabpanel" aria-labelledby="tab-releases" hidden class="release-list">{model.releases.map((release,index)=><article class="release-history"><div><h2>{lang==='en'&&model.example?`Example · PPO ${release.ppoIteration}${release.bcIteration?` / BC ${release.bcIteration}`:''}`:release.label}</h2><span class="badge badge-purple">GKG {release.packageFormat}</span>{index===0&&<span class="badge">{t(lang,'最新发布','Latest')}</span>}</div><p>{release.notes[lang]}</p><footer><span>{release.createdAt}</span><button class="text-link" data-select-release={index}>{t(lang,'查看版本信息','View release')}<Icon name="arrow" size={15}/></button></footer></article>)}</section>
  </div><aside class="release-sidebar"><div class="download-panel"><div class="eyebrow">MODEL RELEASE</div><label for="release-select" class="field-label">{t(lang,'选择发布版本','Select a release')}</label><select id="release-select">{model.releases.map((release,index)=><option value={index}>{lang==='en'&&model.example?`Example · PPO ${release.ppoIteration}${release.bcIteration?` / BC ${release.bcIteration}`:''}`:release.label}</option>)}</select>
    {model.releases.map((release,index)=><div data-release-panel={index} hidden={index!==0}><dl class="release-facts"><div><dt>{t(lang,'模型协议','Model protocol')}</dt><dd>V{release.modelProtocol}</dd></div><div><dt>{t(lang,'部署包','Package')}</dt><dd>GKG {release.packageFormat}</dd></div><div><dt>PPO / BC</dt><dd>{release.ppoIteration} / {release.bcIteration}</dd></div><div><dt>{t(lang,'文件大小','File size')}</dt><dd>{formatBytes(release.sizeBytes,lang)}</dd></div><div><dt>{t(lang,'发布日期','Published')}</dt><dd>{release.createdAt}</dd></div></dl><p class="attachment-label">{t(lang,'附带内容','Included content')}</p><div class="tag-row">{release.attachments.length?release.attachments.map(a=><span class="tag">{attachmentNames[a]?.[lang]||a}</span>):<span class="muted no-attachments">{t(lang,'无可选附件','No optional attachments')}</span>}</div>{release.url?<a class="button button-primary download-button" href={release.url} target="_blank" rel="noopener noreferrer"><Icon name="download" size={17}/>{t(lang,'前往下载','Download from author')}<Icon name="external" size={13}/></a>:<button class="button button-primary download-button" disabled><Icon name="download" size={17}/>{t(lang,'示例暂不提供下载','No download for this example')}</button>}<p class="download-hint">{t(lang,'模型文件由发布者托管','Model files are hosted by the publisher')}</p>{release.sha256&&<div class="checksum"><span>SHA256</span><code>{release.sha256}</code><button class="text-link" data-copy={release.sha256}><Icon name="copy" size={13}/>{t(lang,'复制摘要','Copy checksum')}</button></div>}
      {!model.example && release.sourceUrl && <a class="text-link source-link" href={release.sourceUrl} target="_blank" rel="noopener noreferrer">{t(lang,'作者发布页面','Author release page')}<Icon name="external" size={13}/></a>}
      {!model.example && release.technical && <details class="technical-details"><summary>{t(lang,'GKG 制品信息','GKG artifact details')}</summary>
        <dl>{[
          [t(lang,'文件名','Filename'),release.technical.filename],
          [t(lang,'模型 UUID','Model UUID'),release.technical.modelId],
          [t(lang,'模型前缀','Model prefix'),release.technical.modelPrefix],
          [t(lang,'展示制品','Featured artifact'),release.primaryArtifact],
          [t(lang,'包内模型文件数','Model artifacts in package'),release.technical.artifacts?.length],
          [t(lang,'协议修订号','Protocol revision'),release.technical.protocol?.schemaRevision],
          [t(lang,'词表卡牌数','Vocabulary cards'),release.technical.protocol?.cardCount],
          [t(lang,'语义表卡牌数','Semantic table cards'),release.technical.protocol?.semanticLookupCardCount],
          [t(lang,'协议摘要','Protocol hash'),release.technical.protocol?.schemaHash],
          [t(lang,'词表摘要','Vocabulary hash'),release.technical.protocol?.cardVocabHash],
          [t(lang,'语义摘要','Semantic hash'),release.technical.protocol?.semanticLookupHash],
        ].filter(([,value])=>value!==undefined&&value!==null&&value!=='').map(([label,value])=><div><dt>{label}</dt><dd>{String(value)}</dd></div>)}</dl>
        <p>{t(lang,'信息来自发布包清单；实际兼容性以 Core 或 Link 导入结果为准','Information comes from the package manifest. Core or Link checks compatibility on import.')}</p>
      </details>}
    </div>)}
    </div><div class="info-panel"><h3>{t(lang,'项目信息','Project information')}</h3><dl class="release-facts"><div><dt>{t(lang,'许可证','License')}</dt><dd>{model.example?t(lang,'未声明','Not specified'):model.license}</dd></div><div><dt>{t(lang,'更新日期','Updated')}</dt><dd>{model.updatedAt}</dd></div></dl><div class="tag-row">{model.tags.map(tag=><a class="tag" href={`${path(lang,'models')}?q=${encodeURIComponent(tag)}`}>{tag}</a>)}</div><a class="text-link" href={path(lang,'docs/understand-formats')}>{t(lang,'了解部署包格式','Understand package formats')}<Icon name="arrow" size={14}/></a></div></aside></div>
  <Discussion lang={lang} modelId={model.id} example={model.example}/>
</div></Layout>
<script>
const tabs=[...document.querySelectorAll<HTMLButtonElement>('[data-tab]')];
function activate(tab:HTMLButtonElement){tabs.forEach(button=>{const active=tab===button;button.setAttribute('aria-selected',String(active));button.tabIndex=active?0:-1;(document.querySelector(`#panel-${button.dataset.tab}`)as HTMLElement).hidden=!active;});}
tabs.forEach((tab,index)=>{tab.addEventListener('click',()=>activate(tab));tab.addEventListener('keydown',event=>{if(['ArrowLeft','ArrowRight','Home','End'].includes(event.key)){event.preventDefault();const next=event.key==='Home'?0:event.key==='End'?tabs.length-1:(index+(event.key==='ArrowRight'?1:tabs.length-1))%tabs.length;activate(tabs[next]);tabs[next].focus();}});});
const select=document.querySelector<HTMLSelectElement>('#release-select')!;
const update=()=>document.querySelectorAll<HTMLElement>('[data-release-panel]').forEach(panel=>panel.hidden=panel.dataset.releasePanel!==select.value);
select.addEventListener('change',update);document.querySelectorAll<HTMLButtonElement>('[data-select-release]').forEach(button=>button.addEventListener('click',()=>{select.value=button.dataset.selectRelease!;update();select.focus();}));
</script>
<style>
.model-title-row{display:flex;gap:24px;align-items:center;margin-bottom:30px}.model-avatar{width:94px;height:94px;border:1px solid #e0d5ec;border-radius:16px;background:#f1ecf8;flex-shrink:0;overflow:hidden;color:#9275b6}.model-avatar.accent-amber{background:#f4ecdb;color:#a5884b;border-color:#e9dfc7}.model-avatar.accent-teal{background:#e8f1ed;color:#629280;border-color:#d6e5dc}.model-avatar :global(svg){height:100%;width:175%;max-width:none;margin-left:-37.5%}.model-title-row h1{font-family:var(--serif);font-size:32px;margin-top:7px}.model-title-row p{font-size:12px;margin-top:10px}.detail-author{display:flex;gap:13px;align-items:center;font-size:11px;color:#94879c}.detail-author a{display:flex;gap:6px;align-items:center}.detail-save{margin-left:auto;white-space:nowrap}.detail-layout{display:grid;grid-template-columns:minmax(0,1fr) 320px;gap:55px;align-items:start}.detail-tabs{display:flex;gap:30px;border-bottom:1px solid var(--line)}.detail-tabs button{padding:15px 0;border:0;border-bottom:2px solid transparent;background:none;font-size:13px;color:var(--muted);display:flex;gap:8px;align-items:center}.detail-tabs button[aria-selected=true]{color:var(--purple);border-bottom-color:var(--purple)}.detail-tabs button>span{font-size:9px;background:#ede8f3;border-radius:4px;padding:0 5px}.detail-prose{padding-top:6px}.detail-prose p{font-size:13px}.detail-note{display:flex;gap:14px;padding:20px;background:#f0edf5;border-radius:7px;margin-top:16px;color:#8b749e}.detail-note strong{font-size:13px;font-weight:500}.detail-note p{font-size:12px;margin-top:6px;margin-bottom:0}.download-panel,.info-panel{padding:23px;background:white;border:1px solid var(--line);border-radius:8px}.field-label{display:block;font-size:12px;margin:14px 0 8px;color:#84778e}select{width:100%;padding:11px 10px;border:1px solid #dfd7e7;border-radius:5px;background:#fcfbfd;color:#64516f;font-size:12px}.release-facts{margin:21px 0 0}.release-facts>div{display:flex;justify-content:space-between;gap:16px;padding:8px 0;font-size:11px}.release-facts dt{color:#99909f}.release-facts dd{margin:0;color:#5c5266;text-align:right;overflow-wrap:anywhere}.attachment-label{border-top:1px solid var(--line);padding-top:17px;margin-top:15px;font-size:11px;color:#998da3}.download-panel .tag-row{margin-top:10px}.no-attachments{font-size:11px}.download-button{width:100%;font-size:12px;margin-top:24px;padding-inline:12px}.download-hint{text-align:center;font-size:10px;margin-top:10px}.info-panel{margin-top:18px}.info-panel h3{font-size:14px}.info-panel .release-facts{margin-top:10px}.info-panel .text-link{margin-top:21px;font-size:11px}.release-history{border-bottom:1px solid var(--line);padding:28px 0}.release-history>div{display:flex;align-items:center;gap:10px;flex-wrap:wrap}.release-history h2{font-size:19px}.release-history p{font-size:12px;margin-top:13px}.release-history footer{display:flex;align-items:center;justify-content:space-between;margin-top:18px;font-size:10px;color:#978b9f}.release-history button{border:0;background:none}.checksum{margin-top:20px;padding-top:15px;border-top:1px solid var(--line);font-size:10px;color:var(--muted)}.checksum code{display:block;overflow-wrap:anywhere;font-size:9px;margin:8px 0}.checksum button{border:0;background:none;padding:0;font-size:10px}@media(max-width:900px){.detail-layout{gap:28px;grid-template-columns:minmax(0,1fr) 290px}.model-title-row{gap:18px}.model-title-row h1{font-size:28px}}@media(max-width:760px){.model-title-row{flex-wrap:wrap;gap:15px}.model-avatar{width:68px;height:68px;border-radius:11px}.model-title-row>div:nth-child(2){flex:1;min-width:210px}.model-title-row h1{font-size:24px}.model-title-row p{font-size:11px}.detail-save{margin-left:0;padding:9px 15px;min-height:36px;font-size:11px}.detail-layout{grid-template-columns:1fr;gap:30px}.release-sidebar{grid-row:1}.download-panel{padding:20px}.info-panel{display:none}.detail-author{font-size:9px;gap:8px}.detail-prose{font-size:12px}.release-history h2{font-size:17px}}
.source-link{margin-top:16px;font-size:11px;display:inline-flex;align-items:center;gap:6px}.technical-details{margin-top:18px;padding-top:16px;border-top:1px solid var(--line);font-size:11px}.technical-details summary{cursor:pointer;color:var(--purple);line-height:1.8}.technical-details dl{margin-top:15px}.technical-details dl>div{margin-top:12px}.technical-details dt{color:var(--muted);font-size:10px}.technical-details dd{margin:5px 0 0;overflow-wrap:anywhere;font-family:ui-monospace,monospace;font-size:10px;line-height:1.6}.technical-details p{font-size:10px;line-height:1.8;margin-top:15px}</style>
