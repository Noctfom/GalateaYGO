---
import Layout from '../../../layouts/Layout.astro';
import Icon from '../../../components/Icon.astro';
import { text as t, path, type Lang } from '../../../lib/catalog';
import { guides } from '../../../data/guides';

export function getStaticPaths() {
  return ['zh', 'en'].flatMap(lang => guides.map(guide => ({ params: { lang, slug: guide.slug }, props: { guide } })));
}

const lang = Astro.params.lang as Lang;
const { guide } = Astro.props;
const guideIndex = guides.findIndex(item => item.slug === guide.slug);
const nextGuide = guides[(guideIndex + 1) % guides.length];
---

<Layout lang={lang} active="docs" title={guide.title[lang]} description={guide.summary[lang]}>
  <div class="container page-content">
    <a class="text-link docs-back" href={path(lang, 'docs')}><span aria-hidden="true">←</span>{t(lang, '全部文档', 'All documentation')}</a>
    <div class="docs-layout">
      <aside class="docs-nav">
        <p class="eyebrow">{t(lang, '使用指南', 'USER GUIDES')}</p>
        <nav aria-label={t(lang, '文档导航', 'Documentation navigation')}>
          {guides.map(item => <a href={path(lang, `docs/${item.slug}`)} class:list={{active: item.slug === guide.slug}} aria-current={item.slug === guide.slug ? 'page' : undefined}>{item.title[lang]}<Icon name="chevron" size={14}/></a>)}
        </nav>
        <a class="docs-nav-extra" href="https://github.com/Noctfom/Galatea-Core#readme" target="_blank" rel="noopener noreferrer">{t(lang, 'Core 完整文档', 'Full Core documentation')}<Icon name="external" size={13}/></a>
      </aside>

      <article class="docs-article prose">
        <header>
          <div class="article-meta"><span class="tag">{guide.category[lang]}</span><span><Icon name="clock" size={14}/>{t(lang, `约 ${guide.readMinutes} 分钟`, `${guide.readMinutes} min read`)}</span></div>
          <h1>{guide.title[lang]}</h1>
          <p class="article-summary">{guide.summary[lang]}</p>
        </header>
        {guide.sections.map((section, index) => <section id={`section-${index + 1}`}><h2>{section.title[lang]}</h2><p>{section.body[lang]}</p></section>)}
        <a class="next-guide" href={path(lang, `docs/${nextGuide.slug}`)}>
          <span><small>{t(lang, '继续阅读', 'CONTINUE READING')}</small><strong>{nextGuide.title[lang]}</strong></span><Icon name="arrow" size={20}/>
        </a>
      </article>
    </div>
  </div>
</Layout>

<style>
  .docs-back{display:inline-flex;align-items:center;gap:8px;margin-bottom:32px;font-size:13px}
  .docs-nav .eyebrow{font-size:11px;margin:0 0 16px}.docs-nav nav{display:flex;flex-direction:column;gap:5px}
  .docs-nav nav a{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 14px;border-radius:8px;font-size:13px;color:#77727d;line-height:1.7;transition:background .15s,color .15s}
  .docs-nav nav a:hover{background:#efedf2;color:#38303e}.docs-nav nav a.active{background:#ece7f3;color:#6b4597;font-weight:600}
  .docs-nav-extra{display:flex;align-items:center;gap:9px;color:#83798c;font-size:12px;border-top:1px solid #e5e1e7;margin-top:26px;padding-top:23px}
  .article-meta{display:flex;align-items:center;gap:16px;font-size:12px;color:#8c8392}.article-meta>span:last-child{display:flex;align-items:center;gap:6px}
  .docs-article h1{font-size:clamp(27px,3.2vw,39px);letter-spacing:-.04em;line-height:1.45;margin:23px 0 15px}
  .article-summary{font-size:16px!important;color:#88808e!important;margin:0!important;line-height:1.9!important}
  .docs-article header{padding-bottom:31px;border-bottom:1px solid #e5e1e7;margin-bottom:34px}.docs-article section{scroll-margin-top:100px;margin-top:31px}
  .docs-article section h2{font-size:20px;letter-spacing:-.025em;margin:0 0 12px}.docs-article section p{font-size:15px;line-height:2.1;color:#716a78;margin:0}
  .next-guide{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-top:42px;padding:23px 25px;background:#f1edf5;border:1px solid #e5deee;border-radius:12px;color:#684b89}
  .next-guide small{display:block;font-size:10px;letter-spacing:.1em;color:#9685a7;margin-bottom:7px}.next-guide strong{font-size:15px;font-weight:500}
  @media(max-width:800px){.docs-nav-extra{display:none}.docs-nav nav{flex-direction:row;flex-wrap:wrap}.docs-nav nav a{padding:7px 10px;font-size:12px}.docs-nav nav a svg{display:none}.docs-nav .eyebrow{display:none}.docs-article{margin-top:22px}}
</style>
