{
  "name": "galateaygo",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "node scripts/validate-registry.mjs && astro build && node scripts/check-build.mjs",
    "build:demo": "node scripts/build-demo.mjs",
    "preview": "astro preview --host 127.0.0.1",
    "validate": "node scripts/validate-registry.mjs",
    "inspect:gkg": "node scripts/inspect-gkg.mjs",
    "submission": "node scripts/prepare-submission.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@noble/hashes": "2.4.0",
    "@zip.js/zip.js": "2.24.0",
    "astro": "5.18.2"
  },
  "overrides": {
    "astro": {
      "unifont": "0.7.4"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1"
  }
}
