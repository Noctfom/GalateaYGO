# 只在需要演示条目的预览构建中开启
PUBLIC_DEMO_MODE=false

# 默认已连接正式社区仓库，派生站点可覆盖为自己的 owner/repository
PUBLIC_COMMUNITY_REPOSITORY=Noctfom/GalateaYGO

# 仓库已开启 Discussions，可改为 false 隐藏讨论入口
PUBLIC_GITHUB_DISCUSSIONS_ENABLED=true

# 安装 giscus GitHub App 后，从 https://giscus.app/ 获取以下公开配置
# 本站已内置以下公开配置，派生站点需替换为自己仓库的三项配置
PUBLIC_GISCUS_REPO_ID=R_kgDOVlSM_Q
PUBLIC_GISCUS_CATEGORY=Announcements
PUBLIC_GISCUS_CATEGORY_ID=DIC_kwDOVlSM_c4DKhyU
